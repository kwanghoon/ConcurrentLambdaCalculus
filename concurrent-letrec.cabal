cabal-version: 2.4
name: concurrent-letrec
version: 0.1.0.0
build-type: Simple
license: BSD-3-Clause
synopsis: Concurrent lambda calculus extending EOPL LETREC, with calculated compiler and VM

library
  hs-source-dirs: src
  exposed-modules:
      Syntax
      CTree
      Channel
      Eval
      Machine
      Runner
      Examples
  build-depends: base >=4.14 && <5
  default-language: Haskell2010
  ghc-options: -Wall

executable concurrent-letrec
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: base >=4.14 && <5, concurrent-letrec
  default-language: Haskell2010
  ghc-options: -Wall

test-suite concurrent-letrec-test
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: base >=4.14 && <5, concurrent-letrec
  default-language: Haskell2010
  ghc-options: -Wall
